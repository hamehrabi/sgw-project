# Environment variable template
#
# RULES
# - Placeholders only. Never commit real credentials, tokens, or keys.
# - Every value here must also appear in the environment-config specification with
#   its purpose, an example value, and a security note.
# - Values marked SECRET must never be printed in logs or error messages.

# --- Application -----------------------------------------------------------
APP_ENV=development

# --- Session and password handling (ADR-003, SEC-A-001 to SEC-A-005) --------
# SECRET. Signs the server-side session. Rotating it signs everyone out, which is
# the intended behaviour, not a side effect.
SESSION_SIGNING_KEY=replace-me-with-a-long-random-value

# Idle expiry, and the absolute cap. Both from ADR-006: control rooms run 12-hour shifts,
# and an operator logged out mid-storm is a safety problem rather than a security win.
# Admin actions re-authenticate regardless of session age.
SESSION_IDLE_TIMEOUT_MINUTES=240
SESSION_ABSOLUTE_MAX_HOURS=12

# Cost factor for password hashing. Higher is slower and stronger.
PASSWORD_HASH_COST=12

# --- Store (ADR-002) -------------------------------------------------------
# Path to the single embedded database file. Not a secret in itself, but it is never
# logged and never returned in an error message: the path is a hint about the host.
# The file itself is git-ignored — it holds critical-infrastructure asset locations.
DATABASE_PATH=./data/app.db

# --- Prepared scenario uploads (REQ-F-010, SEC-Z-002, Q-017) ---------------
# Where admin-uploaded storm files are stored, under generated identifiers. Never
# under a supplied filename.
SCENARIO_UPLOAD_DIR=./data/scenarios

# Maximum bytes for one uploaded file, and for one whole scenario. A prepared scenario is
# a manifest plus four CSVs, under 5 MB at demo scale (Q-017) — these are set at roughly
# double that, so a legitimate dataset never trips them and an unbounded upload cannot.
SCENARIO_MAX_FILE_BYTES=8388608
SCENARIO_MAX_TOTAL_BYTES=10485760

# How long the parse job may run before the load fails as a whole. 120 s is generous for
# ~7,500 CSV rows; a parse that exceeds it has found something other than slow parsing.
SCENARIO_PARSE_TIMEOUT_SECONDS=120

# --- Language model, for phrasing computed reasons only (ADR-009) -----------
# SECRET. The ONLY external service in this system. It phrases reasons the scorer has
# already computed; it never scores, ranks, or sees an asset. If it is unreachable the
# ranking renders computed text and the product keeps working.
OPENAI_API_KEY=replace-me

# Pinned. Never "latest" — a silent model change is a silent behaviour change, and
# ai-evals.md re-runs on any change to this value.
OPENAI_MODEL=

# Hard cost guard. A ranking phrases up to 220 reasons; unbounded, that is an unbounded
# invoice. Exceeding either stops calling the provider and falls back to computed text.
LLM_MAX_CALLS_PER_RANKING=
LLM_MONTHLY_COST_CEILING_USD=

# Off the critical path: a slow provider must never delay a ranking during a storm.
LLM_TIMEOUT_SECONDS=

# --- Deliberately absent ---------------------------------------------------
# There is no database credential: the store is a file, so access to it is filesystem
# access (ADR-002).
# There is no SMTP host and no error-tracking endpoint. OPENAI_API_KEY above is the only
# external credential in the system, and ADR-009 is the decision that put it there.
# If any OTHER external variable appears here, it means a dependency was added without a
# decision — check the change log before adding one.

# Blueprint: blueprints/env-example.md
