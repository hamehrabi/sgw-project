# Secrets — never commit real values
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Local data — the store is a single file (ADR-002), and it holds critical-infrastructure
# asset locations. It is never committed, at any size, for any reason.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Uploaded prepared scenarios — admin-uploaded files, stored under generated identifiers.
# They describe SGW's grid and water network; they belong on the host, not in history.
data/scenarios/
uploads/

# Dependencies and build output
node_modules/
venv/
.venv/
__pycache__/
dist/
build/
coverage/

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log

# Blueprint: blueprints/gitignore.md
