# --- local only, never pushed ---
# git does NOT support trailing comments on a pattern line - keep them above.
# The specification workspace IS committed. It has its own spec/.gitignore, which keeps the
# database, uploaded scenarios and real .env values out - see ADR-002.
# Client briefing PDFs are committed - they are the source the spec was derived from.

# --- secrets ---
.env
.env.*
!.env.example

# --- data: ADR-002 forbids committing the database ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- node ---
node_modules/
.next/
out/
npm-debug.log*

# --- os / editor ---
.DS_Store
Thumbs.db
